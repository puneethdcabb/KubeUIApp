<Window x:Class="KubeUIApp.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Action" Height="220" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextLightBrush}"
        FontFamily="Segoe UI" WindowStyle="ToolWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitle" Grid.Row="0" Text="Confirm Deletion" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentDangerBrush}"/>

        <TextBlock x:Name="TxtMessage" Grid.Row="1" Text="Are you sure you want to perform this action?" 
                   TextWrapping="Wrap" Margin="0,12,0,12" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>

        <CheckBox x:Name="ChkForce" Grid.Row="2" Content="Force delete (skip graceful termination)" 
                  Margin="0,0,0,16" Foreground="{DynamicResource AccentWarningBrush}" Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Width="85" Height="30" Margin="0,0,10,0"
                    Style="{StaticResource ModernBtn}" Click="OnCancelClick"/>
            <Button x:Name="BtnConfirm" Content="Confirm" IsDefault="True" Width="85" Height="30"
                    Style="{StaticResource DangerBtn}" Click="OnConfirmClick"/>
        </StackPanel>
    </Grid>
</Window>
