<Window x:Class="KubeUIApp.Views.FileViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Viewer" Height="680" Width="880"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextLightBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtFilePath" Grid.Column="0" Text="/path/to/file" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AccentPrimaryBrush}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBox x:Name="TxtSearch" Width="170" Height="30" TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" ToolTip="Type to search, press Enter for next match"/>
            </StackPanel>

            <Button Content="💾 Copy to Windows File..." Grid.Column="2" Height="30" Padding="12,0" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryBtn}" Click="OnSaveClick"/>
            <Button Content="📋 Copy to Clipboard" Grid.Column="3" Height="30" Padding="12,0"
                    Style="{StaticResource ModernBtn}" Click="OnCopyClick"/>
        </Grid>

        <!-- Content -->
        <Border Grid.Row="1" Background="{DynamicResource TerminalBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <TextBox x:Name="TxtContent" 
                     Background="Transparent" Foreground="{DynamicResource TerminalFgBrush}" 
                     FontFamily="Cascadia Code, Consolas, Courier New" FontSize="12.5"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     IsInactiveSelectionHighlightEnabled="True" SelectionBrush="{DynamicResource AccentPrimaryBrush}" SelectionOpacity="0.45"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0" Padding="12"/>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
            <Button Content="Close" IsCancel="True" Width="85" Height="30" HorizontalAlignment="Right"
                    Style="{StaticResource ModernBtn}" Click="OnCloseClick"/>
        </Grid>
    </Grid>
</Window>
