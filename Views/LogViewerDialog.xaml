<Window x:Class="KubeUIApp.Views.LogViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log Viewer" Height="720" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextLightBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtTitle" Grid.Column="0" Text="Logs" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Copy Logs" Width="90" Height="30" Margin="0,0,8,0"
                            Style="{StaticResource ModernBtn}" Click="OnCopyClick"/>
                    <Button Content="Save As..." Width="85" Height="30"
                            Style="{StaticResource ModernBtn}" Click="OnSaveClick"/>
                </StackPanel>
            </Grid>

            <!-- Filter and settings bar -->
            <WrapPanel Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center">
                <TextBlock Text="Container:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextMutedBrush}"/>
                <ComboBox x:Name="CmbContainers" Width="140" Height="30" Margin="0,0,14,0"
                          SelectionChanged="OnContainerChanged"/>

                <TextBlock Text="Tail lines:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextMutedBrush}"/>
                <ComboBox x:Name="CmbLines" Width="85" Height="30" Margin="0,0,14,0"
                          SelectionChanged="OnLinesChanged">
                    <ComboBoxItem Content="100"/>
                    <ComboBoxItem Content="300" IsSelected="True"/>
                    <ComboBoxItem Content="500"/>
                    <ComboBoxItem Content="1000"/>
                    <ComboBoxItem Content="3000"/>
                </ComboBox>

                <CheckBox x:Name="ChkPrevious" Content="Previous crashed instance" VerticalAlignment="Center" Margin="0,0,14,0"
                          Foreground="{DynamicResource TextLightBrush}" Click="OnPreviousToggled"/>

                <CheckBox x:Name="ChkAutoTail" Content="Auto-Refresh (3s)" VerticalAlignment="Center" Margin="0,0,14,0"
                          Foreground="{DynamicResource AccentPrimaryBrush}" Click="OnAutoTailToggled"/>

                <Button x:Name="BtnRefresh" Content="🔄 Refresh" Width="90" Height="30" Margin="0,0,14,0"
                        Style="{StaticResource PrimaryBtn}" Click="OnRefreshClick"/>

                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBox x:Name="TxtSearch" Width="170" Height="30" TextChanged="OnSearchTextChanged"/>
            </WrapPanel>
        </Grid>

        <!-- Log Content -->
        <Border Grid.Row="1" Background="{DynamicResource TerminalBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <TextBox x:Name="TxtLogs" 
                     Background="Transparent" Foreground="{DynamicResource TerminalFgBrush}" 
                     FontFamily="Cascadia Code, Consolas, Courier New" FontSize="12.5"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0" Padding="12"/>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
            <Button Content="Close" IsCancel="True" Width="85" Height="30" HorizontalAlignment="Right"
                    Style="{StaticResource ModernBtn}" Click="OnCloseClick"/>
        </Grid>
    </Grid>
</Window>
