<Window x:Class="KubeUIApp.Views.PodExecDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pod Terminal / Exec" Height="620" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextLightBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="TxtTitle" Grid.Row="0" Text="Exec in Pod" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,10"/>

        <!-- Command input row -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Container:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextMutedBrush}"/>
            <ComboBox x:Name="CmbContainers" Grid.Column="1" Height="32" Margin="0,0,12,0"/>

            <TextBlock Text="Command:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextMutedBrush}"/>
            <TextBox x:Name="TxtCommand" Grid.Column="3" Height="32" Text="sh -c 'uname -a &amp;&amp; uptime'" KeyDown="OnCommandKeyDown"/>

            <Button Content="Run" Grid.Column="4" Width="75" Height="32" Margin="8,0,0,0"
                    Style="{StaticResource PrimaryBtn}" Click="OnRunClick"/>
        </Grid>

        <!-- Output Terminal -->
        <Border Grid.Row="2" Background="{DynamicResource TerminalBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <TextBox x:Name="TxtOutput" 
                     Background="Transparent" Foreground="{DynamicResource TerminalFgBrush}" 
                     FontFamily="Cascadia Code, Consolas, Courier New" FontSize="12.5"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0" Padding="12"/>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
            <Button Content="Close" IsCancel="True" Width="85" Height="30" HorizontalAlignment="Right"
                    Style="{StaticResource ModernBtn}" Click="OnCloseClick"/>
        </Grid>
    </Grid>
</Window>
