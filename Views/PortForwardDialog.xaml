<Window x:Class="KubeUIApp.Views.PortForwardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔌 Pod Port Forwarding Tunnel" Height="480" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextLightBrush}"
        FontFamily="Segoe UI" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="🔌 One-Click Pod Port Forwarding" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Target Pod:" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,10,2"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtPodInfo" Text="pod-name (namespace)" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Pod IP Address:" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,2,10,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtPodIp" Text="10.x.x.x" Foreground="{DynamicResource TextLightBrush}" Margin="0,2,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Configuration Inputs -->
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Container Port -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Container Port:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextLightBrush}"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtContainerPort" Text="8080" Height="30" Margin="0,0,8,10" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="(Port inside pod)" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>

                <!-- Local Windows Port -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Local Windows Port:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextLightBrush}"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtLocalPort" Text="8080" Height="30" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                <Button Grid.Row="1" Grid.Column="2" Content="🎲 Random Free" Width="110" Height="30" Style="{StaticResource ModernBtn}" Click="OnRandomPortClick"/>
            </Grid>
        </Border>

        <!-- Tunnel Status Card -->
        <Border Grid.Row="2" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtTunnelStatus" Text="⚪ Tunnel Stopped" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtTunnelUrl" Text="http://localhost:8080" FontSize="14" HorizontalAlignment="Center" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,12" Visibility="Collapsed"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnToggleTunnel" Content="⚡ Start Tunnel" Width="140" Height="34" Margin="0,0,10,0" Style="{StaticResource PrimaryBtn}" Click="OnToggleTunnelClick"/>
                    <Button x:Name="BtnOpenBrowser" Content="🌐 Open Browser" Width="130" Height="34" Margin="0,0,10,0" Style="{StaticResource ModernBtn}" Click="OnOpenBrowserClick" IsEnabled="False"/>
                    <Button x:Name="BtnCopyUrl" Content="📋 Copy URL" Width="100" Height="34" Style="{StaticResource ModernBtn}" Click="OnCopyUrlClick" IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="Tunnel routes directly from Windows localhost to the container through SSH." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
            <Button Content="Close" Width="90" Height="32" HorizontalAlignment="Right" Style="{StaticResource ModernBtn}" Click="OnCloseClick"/>
        </Grid>
    </Grid>
</Window>