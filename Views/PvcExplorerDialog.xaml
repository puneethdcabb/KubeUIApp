<Window x:Class="KubeUIApp.Views.PvcExplorerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PVC File Explorer" Height="700" Width="950"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextLightBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header & Mount info -->
            <RowDefinition Height="Auto"/>
            <!-- Nav Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Files Grid -->
            <RowDefinition Height="*"/>
            <!-- Action Toolbar & Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header & Mount Info -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="💾 PVC: " FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        <TextBlock x:Name="TxtPvcName" Text="my-pvc" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextLightBrush}"/>
                        <TextBlock x:Name="TxtNamespace" Text=" (default)" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtMountInfo" Text="Detecting mount source..." FontSize="12" Foreground="{DynamicResource AccentSuccessBrush}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="🔄 Refresh Files" Width="105" Height="30" Style="{StaticResource ModernBtn}" Click="OnRefreshClick"/>
            </Grid>
        </Border>

        <!-- Navigation Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="🏠 Root" Grid.Column="0" Width="65" Height="30" Margin="0,0,6,0" Style="{StaticResource ModernBtn}" Click="OnRootClick"/>
            <Button Content="⬆️ Up" Grid.Column="1" Width="55" Height="30" Margin="0,0,8,0" Style="{StaticResource ModernBtn}" Click="OnUpClick"/>
            <TextBox x:Name="TxtCurrentPath" Grid.Column="2" Height="30" Margin="0,0,8,0" VerticalContentAlignment="Center" KeyDown="OnPathKeyDown"/>
            <Button Content="Go" Grid.Column="3" Width="50" Height="30" Style="{StaticResource PrimaryBtn}" Click="OnGoClick"/>
        </Grid>

        <!-- Files DataGrid -->
        <DataGrid Grid.Row="2" x:Name="DgFiles" MouseDoubleClick="OnFilesDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding DisplayIcon}" Width="45"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2.5*"/>
                <DataGridTextColumn Header="Size" Binding="{Binding DisplaySize}" Width="100"/>
                <DataGridTextColumn Header="Permissions" Binding="{Binding Permissions}" Width="110"/>
                <DataGridTextColumn Header="Last Modified" Binding="{Binding LastModified, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer & Action Toolbar -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Actions on selected item -->
            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                <Button Content="💾 Copy to Windows PC..." Width="165" Height="32" Margin="0,2,8,2" Style="{StaticResource PrimaryBtn}" Click="OnCopyToWindowsClick"/>
                <Button Content="👁️ View File" Width="95" Height="32" Margin="0,2,8,2" Style="{StaticResource ModernBtn}" Click="OnViewFileClick"/>
                <Button Content="📤 Copy File to PVC" Width="140" Height="32" Margin="0,2,8,2" Style="{StaticResource ModernBtn}" Click="OnUploadToPvcClick"/>
                <Button Content="📋 Copy Path" Width="95" Height="32" Margin="0,2,0,2" Style="{StaticResource ModernBtn}" Click="OnCopyPathClick"/>
            </WrapPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatus" Text="Ready" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                <Button Content="Close" IsCancel="True" Width="85" Height="32" Style="{StaticResource ModernBtn}" Click="OnCloseClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
