<Window x:Class="KubeUIApp.Views.SecretViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Secret Details &amp; Data Inspector" Height="720" Width="1020"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextLightBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content Split (Keys list on Left, Viewer on Right) -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="🔑 Secret: " FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        <TextBlock x:Name="TxtSecretName" Text="my-secret" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextLightBrush}"/>
                        <TextBlock x:Name="TxtNamespace" Text=" (default)" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Type: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock x:Name="TxtSecretType" Text="Opaque" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentWarningBrush}" Margin="0,0,16,0"/>
                        <TextBlock Text="Keys: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock x:Name="TxtKeysCount" Text="0 entries" FontSize="12" Foreground="{DynamicResource AccentSuccessBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📄 Full Secret YAML..." Height="30" Padding="12,0" Margin="0,0,8,0" Style="{StaticResource ModernBtn}" Click="OnViewFullYamlClick"/>
                    <Button Content="🔍 Raw Describe..." Height="30" Padding="12,0" Style="{StaticResource ModernBtn}" Click="OnDescribeClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace: Keys list + Value Inspector -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Secret Keys List -->
            <Border Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="DATA KEYS / CERTIFICATES / CRL" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="4,2,4,8"/>

                    <DataGrid Grid.Row="1" x:Name="DgKeys" SelectionMode="Single" SelectionChanged="OnKeySelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Key / File Name" Binding="{Binding Key}" Width="1.8*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Detected Type" Binding="{Binding DetectedType}" Width="1.6*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding ByteLength, StringFormat='{}{0} B'}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="4" Background="Transparent"/>

            <!-- Right: Value Inspector (Decoded vs Base64) -->
            <Border Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- View Mode Controls & Action Buttons -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Toggle View Mode: Decoded vs Raw Base64 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="RbDecoded" Content="📖 Decoded Text / PEM" IsChecked="True" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,12,0" Checked="OnViewModeChanged"/>
                            <RadioButton x:Name="RbBase64" Content="🔒 Raw Base64 String" Foreground="{DynamicResource TextLightBrush}" Checked="OnViewModeChanged"/>
                        </StackPanel>

                        <!-- Export & Copy Toolbar -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="💾 Save Key to Windows File..." Height="28" Padding="10,0" Margin="0,0,6,0" Style="{StaticResource PrimaryBtn}" Click="OnSaveKeyClick"/>
                            <Button Content="📋 Copy Decoded" Height="28" Padding="10,0" Margin="0,0,6,0" Style="{StaticResource ModernBtn}" Click="OnCopyDecodedClick"/>
                            <Button Content="📋 Copy Base64" Height="28" Padding="10,0" Style="{StaticResource ModernBtn}" Click="OnCopyBase64Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Monospace Viewer Box -->
                    <Border Grid.Row="1" Background="{DynamicResource TerminalBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <TextBox x:Name="TxtValue"
                                 Background="Transparent" Foreground="{DynamicResource TerminalFgBrush}"
                                 FontFamily="Cascadia Code, Consolas, Courier New" FontSize="12.5"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 BorderThickness="0" Padding="10"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
            <Button Content="Close" IsCancel="True" Width="85" Height="30" HorizontalAlignment="Right" Style="{StaticResource ModernBtn}" Click="OnCloseClick"/>
        </Grid>
    </Grid>
</Window>
